<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fita.App"
             Name="Fita"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!--
      Botões: um só sistema, e o tema decide a forma (raio, relevo, brilho, maiúsculas) pelos
      recursos que o ThemeManager preenche. É o mesmo princípio dos botões do Jazmin.
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource BtnBg}" />
      <Setter Property="Foreground" Value="{DynamicResource BtnFg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource BtnBorderThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}" />
      <Setter Property="FontFamily" Value="{DynamicResource BtnFont}" />
      <Setter Property="FontWeight" Value="{DynamicResource BtnWeight}" />
      <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource BtnShadow}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource BtnBgHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BtnFgHover}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource BtnShadowHover}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource BtnBgPressed}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource BtnShadowPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource BtnBg}" />
      <Setter Property="Foreground" Value="{DynamicResource BtnFg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource BtnBorderThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource BtnRadius}" />
      <Setter Property="FontFamily" Value="{DynamicResource BtnFont}" />
      <Setter Property="FontWeight" Value="{DynamicResource BtnWeight}" />
      <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource BtnShadow}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource BtnBgHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BtnFgHover}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource BtnShadowHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource BtnShadowPressed}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource ToggleOnBg}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleOnFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleOnBorder}" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource ToggleOnShadow}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Fita/Styles/Fita.axaml" />
  </Application.Styles>
</Application>
