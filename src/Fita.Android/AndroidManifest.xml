<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A música do telemóvel: Android 13+ pede só o áudio; antes disso, o armazenamento. -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- Tocar com o ecrã desligado: serviço em primeiro plano, notificação e o processador acordado. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application android:label="Fita" android:icon="@mipmap/fita" android:allowBackup="false"
               android:extractNativeLibs="true" android:supportsRtl="true">
  </application>
</manifest>
