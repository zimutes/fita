<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Fita.Controls"
             xmlns:lib="using:Fita.Library"
             xmlns:views="using:Fita.Views"
             x:Class="Fita.Views.MobileView"
             FontFamily="{DynamicResource FontSans}"
             Foreground="{DynamicResource Text}"
             FontSize="14">

  <Panel>
    <ctl:Backdrop />

    <DockPanel Name="Root">

      <!-- ── Topo: o nome e o menu ───────────────────────────────────────── -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,8,8,2" Height="40">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <ctl:Glyph Kind="Logo" Width="18" Height="18" Foreground="{DynamicResource Accent}" />
          <ctl:Wordmark Height="14" Foreground="{DynamicResource TitleFg}" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource L.By}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TitleFg}"
                     VerticalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
        <Button Name="MenuButton" Grid.Column="2" Classes="chrome" Width="44" Height="40">
          <ctl:Glyph Kind="Menu" Width="18" Height="18" />
        </Button>
      </Grid>

      <!-- ── Leitor ──────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Top" Classes="panel" Margin="10,4,10,0" Padding="12">
        <StackPanel Spacing="10">

          <Border Name="Lcd" Classes="inset" Padding="12,10" Background="{DynamicResource InsetBg}" ClipToBounds="True">
            <Panel>
              <Image Name="CoverImage" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right"
                     Width="160" Margin="0,-10,-12,-10" Stretch="UniformToFill" Opacity="0.4">
                <Image.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="0.75" Color="Black" />
                  </LinearGradientBrush>
                </Image.OpacityMask>
              </Image>
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*" Height="46">
                  <StackPanel Name="TimeArea" Orientation="Horizontal" Spacing="9" Background="Transparent">
                    <ctl:Glyph Name="StateGlyph" Kind="Stop" Width="12" Height="12" Foreground="{DynamicResource Lcd}"
                               VerticalAlignment="Center" Effect="{DynamicResource LcdEffect}" />
                    <TextBlock Name="TimeText" Text="00:00" Foreground="{DynamicResource Lcd}"
                               FontFamily="{DynamicResource FontTime}" FontWeight="{DynamicResource TimeWeight}"
                               FontSize="{DynamicResource TimeSize}" VerticalAlignment="Center"
                               Effect="{DynamicResource LcdEffect}" />
                  </StackPanel>
                  <ctl:Visualizer Name="Vis" Grid.Column="1" Margin="16,2,0,2" />
                </Grid>
                <ctl:Marquee Name="TitleMarquee" Height="24" FontSize="16" FontWeight="SemiBold"
                             FontFamily="{DynamicResource FontSans}" Foreground="{DynamicResource Lcd}"
                             Effect="{DynamicResource LcdEffect}" />
                <TextBlock Name="InfoText" Classes="lcd" FontSize="11.5" Foreground="{DynamicResource LcdDim}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Name="StatusText" Classes="lcd" FontSize="11.5" Foreground="{DynamicResource LcdDim}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                  <TextBlock Name="IndEq" Classes="indicator" Text="EQ" />
                  <TextBlock Name="IndShuffle" Classes="indicator" Text="SHUF" />
                  <TextBlock Name="IndRepeat" Classes="indicator" Text="REP" />
                  <TextBlock Name="IndRg" Classes="indicator" Text="RG" />
                  <TextBlock Name="IndLimit" Classes="indicator alert" Text="{DynamicResource L.Limit}" />
                </StackPanel>
              </StackPanel>
            </Panel>
          </Border>

          <!-- A barra de posição: grossa para o dedo, e a forma de onda ondula ao arrastar -->
          <ctl:LevelSlider Name="Seek" IsSeekBar="True" Height="44" Margin="0,-8" HitPadding="11" Maximum="1" />

          <!-- Transporte -->
          <Grid ColumnDefinitions="*,*,1.4*,*,*" Height="54">
            <ToggleButton Name="ShuffleToggle" Classes="small" Width="48" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
              <ctl:Glyph Kind="Shuffle" Width="18" Height="18" />
            </ToggleButton>
            <Button Name="PrevButton" Grid.Column="1" Classes="transport" Width="52" Height="46" HorizontalAlignment="Center">
              <ctl:Glyph Kind="Prev" Width="18" Height="18" />
            </Button>
            <Button Name="PlayButton" Grid.Column="2" Classes="transport play" Width="76" Height="52" HorizontalAlignment="Center">
              <ctl:Glyph Name="PlayGlyph" Kind="Play" Width="22" Height="22" />
            </Button>
            <Button Name="NextButton" Grid.Column="3" Classes="transport" Width="52" Height="46" HorizontalAlignment="Center">
              <ctl:Glyph Kind="Next" Width="18" Height="18" />
            </Button>
            <ToggleButton Name="RepeatToggle" Grid.Column="4" Classes="small" Width="48" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
              <ctl:Glyph Name="RepeatGlyph" Kind="Repeat" Width="18" Height="18" />
            </ToggleButton>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Classes="label" Text="{DynamicResource LU.Vol}" />
            <ctl:LevelSlider Name="Volume" Grid.Column="1" Height="32" Maximum="100" DefaultValue="80" />
            <TextBlock Name="VolumeText" Grid.Column="2" Classes="label" Width="28" TextAlignment="Right"
                       FontFamily="{DynamicResource FontMono}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Separadores ────────────────────────────────────────────────── -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="10,8,10,0">
        <ToggleButton Name="TabList" Classes="small tab" Content="{DynamicResource LU.M.TabList}" HorizontalAlignment="Stretch" />
        <ToggleButton Name="TabLibrary" Grid.Column="1" Classes="small tab" Content="{DynamicResource LU.M.TabLibrary}" HorizontalAlignment="Stretch" />
        <ToggleButton Name="TabEq" Grid.Column="2" Classes="small tab" Content="{DynamicResource LU.M.TabEq}" HorizontalAlignment="Stretch" />
      </Grid>

      <!-- ── Conteúdo do separador ───────────────────────────────────────── -->
      <Border Classes="panel" Margin="10,8,10,10" Padding="8">
        <Panel>
          <!-- Lista -->
          <DockPanel Name="ListPanel">
            <TextBlock Name="ListFooter" DockPanel.Dock="Bottom" Classes="muted" FontFamily="{DynamicResource FontMono}"
                       FontSize="11" HorizontalAlignment="Right" Margin="4,6,4,0" />
            <Border Classes="list" ClipToBounds="True">
              <Panel>
                <ListBox Name="PlaylistBox" Classes="playlist" SelectionMode="Single">
                  <!-- Sem virtualização: a lista do telemóvel é curta, e assim não ficam linhas velhas por baixo -->
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="lib:Track">
                      <Grid Classes="row" Classes.current="{Binding IsCurrent}" Classes.failed="{Binding Failed}"
                            ColumnDefinitions="34,*,Auto" Background="Transparent" MinHeight="40">
                        <TextBlock Classes="num" Text="{Binding Number}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Classes="title" Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="dur" Text="{Binding DurationText}" Margin="10,0,4,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Name="ListEmpty" Text="{DynamicResource L.M.ListEmpty}" Classes="muted" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" />
              </Panel>
            </Border>
          </DockPanel>

          <!-- Biblioteca: a música do telemóvel, por álbum -->
          <DockPanel Name="LibraryPanel" IsVisible="False">
            <TextBox Name="SearchBox" DockPanel.Dock="Top" Classes="search" Watermark="{DynamicResource L.M.Search}" Margin="0,0,0,8" />
            <Border Classes="list" ClipToBounds="True">
              <Panel>
                <ListBox Name="LibraryBox" Classes="playlist" SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:LibraryEntry">
                      <Grid Classes="row" Classes.album="{Binding IsAlbum}" Classes.track="{Binding IsTrack}"
                            ColumnDefinitions="*,Auto" Background="Transparent" MinHeight="40">
                        <TextBlock Classes="title" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="dur" Text="{Binding Detail}" Margin="10,0,4,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Name="LibraryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24">
                  <TextBlock Name="LibraryEmptyText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                  <Button Name="GrantButton" Classes="small" HorizontalAlignment="Center" Content="{DynamicResource LU.M.Grant}" />
                </StackPanel>
              </Panel>
            </Border>
          </DockPanel>

          <!-- Equalizador -->
          <ScrollViewer Name="EqPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="2">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                <ToggleButton Name="EqOn" Classes="small" Content="{DynamicResource LU.EqOn}" />
                <ToggleButton Name="EqAuto" Grid.Column="1" Classes="small" Content="{DynamicResource LU.Auto}" />
                <TextBlock Name="PreampInfo" Grid.Column="2" Classes="muted" FontFamily="{DynamicResource FontMono}" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" />
                <Button Name="PresetButton" Grid.Column="3" Classes="small" Content="{DynamicResource LU.Presets}" />
                <Button Name="ResetEqButton" Grid.Column="4" Classes="small" Content="{DynamicResource LU.ResetEq}" />
              </Grid>
              <Border Classes="inset" Height="130" Padding="2" ClipToBounds="True">
                <ctl:EqGraph Name="Graph" />
              </Border>
              <Grid Name="BandGrid" Height="170" />
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </DockPanel>
  </Panel>
</UserControl>
